{
  "name": "@business-os/brand",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./assets/*": "./assets/*",
    "./agents": "./src/agents.ts",
    "./agents/*": "./agents/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "build:assets": "node --experimental-strip-types scripts/build-assets.mjs",
    "build:agents": "node --experimental-strip-types scripts/build-agents.mjs",
    "brand:sync": "node scripts/brand-sync.mjs",
    "brand:check": "node scripts/brand-sync.mjs --check"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
