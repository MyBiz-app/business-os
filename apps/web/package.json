    "@business-os/i18n": "workspace:*",
    "@business-os/verticals": "workspace:*",
    "@sentry/nextjs": "^11.6.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "1.51.0",
    "maplibre-gl": "6.14.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "next-themes": "^0.4.6",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/nextjs-vite": "^10.6.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "storybook": "^10.6.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@12.8.1"
