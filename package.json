{
  "name": "business-os",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:client-app": "pnpm --filter client-app start",
    "dev:app": "pnpm --filter client-app exec expo start --web --port 8081",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "api:generate": "pnpm --filter @business-os/api-client generate",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verticals:export": "pnpm --filter @business-os/verticals export",
    "vertical:new": "pnpm --filter @business-os/verticals new"
  },
  "devDependencies": {
    "supabase": "2.119.0",
    "turbo": "2.11.6"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  }
}
